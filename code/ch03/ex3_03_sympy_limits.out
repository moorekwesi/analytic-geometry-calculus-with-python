2x^2 + 1, x->1               = 3
(x^2-2x+1)/(3x-2), x->3      = 4/7
(x^2-16)/(x-4), x->4         = 8
(sqrt(x+9)-3)/x, x->0        = 1/6
tan(x)/x, x->0               = 1
sin(4x)/x, x->0              = 4
(cos3x - cos x)/x^2, x->0    = -4
(1 - cos x)/x^2, x->0        = 1/2
|x-8|/(x-8): left = -1 , right = 1
