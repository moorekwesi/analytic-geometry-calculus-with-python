∫ 3*x**2                       dx = x**3                               check: True
∫ cos(x)                       dx = sin(x)                             check: True
∫ x**8                         dx = x**9/9                             check: True
∫ x**(-3)                      dx = -1/(2*x**2)                        check: True
∫ x**(2/3)                     dx = 3*x**(5/3)/5                       check: True
∫ tan(x)/sec(x)                dx = -cos(x)                            check: True
∫ 5*x**3 + 2*cos(x)            dx = 5*x**4/4 + 2*sin(x)                check: True
∫ -6*sqrt(x) + 8*x**3 + x**(-3) dx = (-8*x**(7/2) + 4*x**6 - 1)/(2*x**2) check: True
∫ (x**2 - 1)**2/x**2           dx = x**3/3 - 2*x - 1/x                 check: True
∫ 1/(cos(x)*cot(x))            dx = 1/cos(x)                           check: True
